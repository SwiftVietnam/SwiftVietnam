---
import { marked } from 'marked';
import { getSingletonHighlighter } from 'shiki';
import BaseLayout from '../../layouts/BaseLayout.astro';
import dataset from '../../data/news.generated.json';

export function getStaticPaths() {
  const items = dataset.items || [];
  return items.map((item) => ({
    params: { id: String(item.id) },
    props: { item }
  }));
}

const { item } = Astro.props;

const highlighter = await getSingletonHighlighter({
  themes: ['github-light'],
  langs: ['swift', 'objc', 'bash', 'shell', 'javascript', 'typescript', 'json', 'text'],
});

const renderer = new marked.Renderer();
renderer.code = function ({ text, lang }) {
  // Strip excessive blank lines: keep a blank only after a line that closes a
  // top-level block (ends with } or ]), which is an intentional section break.
  // All other blank lines (between params, imports, properties) are removed.
  const lines = text.split('\n');
  const cleaned: string[] = [];
  for (const line of lines) {
    if (line.trim() !== '') {
      cleaned.push(line);
      continue;
    }
    const lastCode = [...cleaned].reverse().find(l => l.trim() !== '');
    const prevIsBlank = cleaned.length > 0 && cleaned[cleaned.length - 1].trim() === '';
    // Keep blank only after a closing brace/bracket at column 0 (top-level block end)
    if (!prevIsBlank && lastCode && /^[}\]]/.test(lastCode.trimEnd())) {
      cleaned.push(line);
    }
  }
  while (cleaned.length > 0 && cleaned[cleaned.length - 1].trim() === '') cleaned.pop();
  const cleanText = cleaned.join('\n');

  const language = lang?.toLowerCase() || 'text';
  try {
    return highlighter.codeToHtml(cleanText, { lang: language, theme: 'github-light' });
  } catch {
    return `<pre class="shiki-fallback"><code>${cleanText}</code></pre>`;
  }
};

const html = marked.parse(item.contentMarkdown || '', { renderer, async: false });

const date = new Date(item.publishedAt).toLocaleDateString('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${item.title} | SwiftVietnam News`} description={item.summaryVi || item.summaryEn} ogImage={item.coverImage || 'https://swiftvietnam.dev/logo.png'}>
  <article class="article">
    <a href="/news/">← Quay lại danh sách</a>
    <h1>{item.title}</h1>
    <div class="meta">
      <span>{date}</span>
      <span class="meta-dot">·</span>
      <span>{item.authorName}</span>
      <span class="meta-dot">·</span>
      <span>{item.platform.toUpperCase()}</span>
      <span class="meta-dot">·</span>
      <span><a href={item.sourceUrl} target="_blank" rel="noreferrer">Nguồn</a></span>
      <span><a href={item.issueUrl} target="_blank" rel="noreferrer">GitHub Issue</a></span>
    </div>
    <p class="summary">{item.summaryVi || item.summaryEn}</p>

    {item.coverImage && <img src={item.coverImage} alt={item.title} class="article-cover" loading="lazy" />}

    <div class="prose" set:html={html}></div>
  </article>
</BaseLayout>
